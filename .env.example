# .env.example
#
# Copy this to .env and fill in real values. .env is gitignored.

STACK_VERSION=9.5.2

# Superuser password for Elasticsearch's built-in 'elastic' account.
ELASTIC_PASSWORD=changeme

# Password for the built-in 'kibana_system' service account, which
# Kibana uses to connect to Elasticsearch. This is NOT the same as
# ELASTIC_PASSWORD -- kibana_system is a separate, lower-privilege
# account meant only for Kibana's own connection, not for logging in
# as a person. You set this yourself; Elasticsearch doesn't generate
# it automatically the way it does with the enrollment-token flow.
KIBANA_SYSTEM_PASSWORD=changeme
